# MongoDB connection
MONGO_URI=mongodb://localhost:27017/exam_proctoring

# Server
PORT=5000

# JWT auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRE=7d

# Email (SMTP) - for sending exam reports
# For Gmail: enable 2FA then create an "App Password" at
# https://myaccount.google.com/apppasswords - use that as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
